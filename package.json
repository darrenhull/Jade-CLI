{
  "name": "jade-tools-cli",
  "version": "0.1.1",
  "private": true,
  "description": "Native Jade development CLI and shared local SDK broker.",
  "bin": {
    "jade-cli": "bin/jade-cli.js"
  },
  "main": "sdk/index.js",
  "exports": {
    ".": "./sdk/index.js",
    "./client": "./sdk/broker-client.js",
    "./automation/cli-release-updater": "./sdk/automation/CliReleaseUpdater.js",
    "./commands": "./sdk/cli-arguments.js",
    "./automation/standalone-packager": "./sdk/automation/StandalonePackager.js"
  },
  "files": [
    "jade-cli.exe",
    "bin",
    "sdk",
    "native-src",
    "scripts/build-native.cjs",
    "scripts/package-standalone.cjs",
    "licenses",
    "ThirdPartyNotices.txt",
    "README.md",
    "docs/architecture.drawio",
    "docs/architecture.drawio.svg"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "build:native": "node scripts/build-native.cjs",
    "package:standalone": "node scripts/package-standalone.cjs",
    "test": "node scripts/test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  }
}
